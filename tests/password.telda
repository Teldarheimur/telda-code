.seg data
buf:
    .string 000000000000000000000000000000000
.seg rodata
correct:
    .string Access Granted!\0
wrong:
    .string Access Denied!\0
prompt:
    .string Enter password:\0
password:
    .string PASS\0

.ref strcmp
.ref print
.ref readLine

.seg text
.entry
start:
    ldi r6, prompt
    call print

    ldi r6, buf
    call readLine
    ldi r6, buf
    ldi r7, password
    call strcmp
    sub r0b, r1l, r0b

    jez success

    ldi r6, wrong
    call print

    jump start

success:
    ldi r6, correct
    call print
    halt
