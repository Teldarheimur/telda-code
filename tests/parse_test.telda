.ref readLine
.ref parse
.ref uitos
.ref print
.ref write

.seg text
start:
.entry
    ldi r6, prompt
    call write

    ldi r6, buf
    call readLine
    ldi r6, buf
    call parse
    or r2, r0, r1

    ldi r6, answer
    call write

    or r6, r0, r2
    ldi r7, buf
    call uitos

    ldi r6, buf
    call print

    halt

.seg rodata
prompt:
    .string Write a number for me to repeat:\n\0
answer:
    .string I will now repeat this very cool number:\n\0


.seg heap
buf:
.string \0