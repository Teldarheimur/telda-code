.ref zero
.ref copy
.ref print
.ref set

.seg text
.entry
    ldi r6, ape
    call print
    ldi r6, ape2
    call print

    ldi r6, 5
    ldi r7, ape
    call zero
    ldi r6, 4
    ldi r7, ape
    ldi r8b, 'A'
    call set
    ldi r6, 5
    ldi r7, ape2
    ldi r8, ape
    call copy

    ldi r6, ape
    call print
    ldi r6, ape2
    call print

    halt

.seg data
ape:
    .string BBBBB\0

ape2:
    .string CCCCC\0
