.seg text
.entry
    ldi r1, 2
    ldi r7, 319
    ldi r4l, 0xff
    ldi r5, 320
    ldi r6, 240
    ldi r2, 0
    ldi r3, 0
loop:
    ; setp
    syscall
    ; x += 2
    add r2, r2, r1
    ; if (x >= width)
    sub r0, r2, r5
    jlt meow
    ; x -= width
    sub r2, r2, r7
    add r3, r3, r1
meow:
    ; y %= height
    div r0, r3, r3, r6
    jmp loop
